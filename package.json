{
  "name": "add-whatsapp-desktop",
  "version": "0.1.0",
  "description": "WhatsApp contact follow-up desktop automation tool",
  "author": "Add WhatsApp",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "build": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.addwhatsapp.desktop",
    "productName": "Add WhatsApp",
    "icon": "assets/icon.ico",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "nsis": {
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  },
  "dependencies": {
    "libphonenumber-js": "^1.11.19",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  }
}
