{
  "name": "add-whatsapp-desktop",
  "version": "0.1.4",
  "description": "WhatsApp contact follow-up desktop automation tool",
  "author": "Add WhatsApp",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "prepare:browser": "node scripts/prepare-browser-bundle.js",
    "prebuild": "npm run prepare:browser",
    "build": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.addwhatsapp.desktop",
    "productName": "Add WhatsApp",
    "icon": "assets/icon.ico",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build-resources/chromium",
        "to": "chromium",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "**/chromium/**"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  },
  "dependencies": {
    "libphonenumber-js": "^1.11.19",
    "puppeteer": "24.38.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "socks": "^2.8.9",
    "whatsapp-web.js": "github:pedroslopez/whatsapp-web.js",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  }
}
